# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repo —
# sekrety wyłącznie w zmiennych środowiskowych.
#
# Plik wciąga się sam w obie strony: compose przez env_file w music-service,
# a serwis uruchamiany na hoście przez spring.config.import w profilu `local`.
# Bez dodatkowych flag; szczegóły w deploy/compose/URUCHAMIANIE.md.
#
# Pusta wartość NIE znaczy "brak wpisu" — dociera do aplikacji jako pusty
# łańcuch i przykrywa wartość domyślną z application.yml. Zmienną, której nie
# ustawiasz, zakomentuj.

# Spotify — Client Credentials (metadane/ISRC) + OAuth PKCE (playlisty)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Adres powrotu z ekranu zgody; musi być identyczny z wpisanym w dashboardzie
# aplikacji Spotify. Odkomentuj tylko, żeby nadpisać wartość domyślną
# (http://127.0.0.1:8080/music/api/v1/auth/spotify/callback) — pusty łańcuch zepsuje logowanie.
# SPOTIFY_REDIRECT_URI=

# Provider LLM do analizy utworów — provider i model tylko w konfiguracji
# LLM_PROVIDER: openai (i API zgodne z OpenAI) | anthropic; LLM_BASE_URL opcjonalny
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Automatyczne odświeżanie playlist ze Spotify. Domyślnie włączone: przy starcie
# aplikacji i potem raz na dobę, licząc od ZAKOŃCZENIA poprzedniego przebiegu.
# Przebieg pobiera tylko playlisty zmienione od ostatniego importu, więc
# odświeżenie bez zmian to jedno wywołanie Spotify. Przy rzadkich zmianach
# ustaw 7d; świeże dane na żądanie daje przycisk „Importuj moje playlisty".
# Nie skracaj odstępu bez potrzeby: kwota Web API liczy się per konto dewelopera
# i jest dzielona ze wzbogacaniem katalogu.
# PLAYLIST_REFRESH_ENABLED=true
# PLAYLIST_REFRESH_INTERVAL=24h
# PLAYLIST_REFRESH_INITIAL_DELAY=10s

# MusicBrainz wymaga User-Agent z kontaktem, np.:
# archon-music/0.1 (https://github.com/pgoogol/archon; you@example.com)
MB_USER_AGENT=

# ── Logowanie ────────────────────────────────────────────────────────────────
# Konto Google: identyfikator klienta OAuth z Google Cloud (typ „Aplikacja
# internetowa"). Nie jest sekretem — przeglądarka i tak go widzi — ale zależy od
# środowiska, więc wchodzi tą samą drogą co reszta. Puste = logowanie wyłącznie
# kontem lokalnym.
GOOGLE_CLIENT_ID=
# Adresy kont, które mają wstęp; kilka rozdziel przecinkiem. Token poprawny, ale
# wystawiony dla konta spoza listy, dostaje 403 — bez tej listy każde konto
# Google na świecie miałoby ważny token.
AUTH_ALLOWED_EMAILS=

# Konto lokalne (login + hasło) działa równolegle z Google i pozwala wejść,
# zanim klient Google zostanie skonfigurowany.
#
# Domyślnie to admin/admin. PRZED WYSTAWIENIEM APLIKACJI PUBLICZNIE podmień hash
# albo wyłącz konto — tę parę skanery próbują jako pierwszą. Hash wygenerujesz
# dowolnym narzędziem BCrypt o sile 12, np. `htpasswd -nbBC 12 admin haslo`
# (bierzesz część po dwukropku).
# AUTH_LOCAL_ENABLED=true
# AUTH_LOCAL_USERNAME=admin
# AUTH_LOCAL_PASSWORD_HASH=

# Wyłącza bramkę logowania w samym froncie (backend i tak wymaga poświadczeń,
# chyba że serwis chodzi z profilem `no-auth`). Do pracy lokalnej i testów E2E.
# AUTH_ENABLED=true
