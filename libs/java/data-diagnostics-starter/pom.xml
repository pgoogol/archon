<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pgoogol</groupId>
    <artifactId>archon-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>data-diagnostics-starter</artifactId>
  <packaging>jar</packaging>

  <name>data-diagnostics-starter</name>
  <description>Starter diagnostyki dostępu do danych — przechwytywanie operacji, analizy (N+1, wolne zapytania), raport wniosków</description>

  <dependencies>
    <!-- rdzeń (com.pgoogol.diagnostics.core) zna tylko SLF4J i adnotacje JSpecify;
         Spring dochodzi jako opcjonalny razem z pierwszą strategią przechwytywania -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- @Nullable bez Springa: org.springframework.lang jest dla rdzenia zakazany -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- tylko do sprawdzenia, że własny zapis JSON parsuje się prawdziwym parserem -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
