<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.pgoogol</groupId>
    <artifactId>archon-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>

  <artifactId>test-diagnostics-starter</artifactId>
  <packaging>jar</packaging>

  <name>test-diagnostics-starter</name>
  <description>Starter diagnostyki przebiegu testów — raport czasu, środowisk testowych Springa i pamięci po każdym forku</description>

  <dependencies>
    <!-- rdzeń (com.pgoogol.testdiagnostics.core) zna tylko JDK i adnotacje JSpecify;
         JUnit i Spring dochodzą razem ze słuchaczami, które się do nich podpinają -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <!-- słuchacz sesji JUnit to główne zadanie startera, więc nie jest opcjonalny;
         konsument i tak bierze starter w zasięgu test -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
    </dependency>

    <!-- opcjonalne: słuchacz Springa działa tylko w module, który sam ma spring-test -->
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
