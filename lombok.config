# Konfiguracja Lomboka dla całego reaktora — moduły nie dopisują własnej.
config.stopBubbling = true

# Wygenerowany kod dostaje @lombok.Generated, więc JaCoCo go nie liczy.
# Bez tego bramka pokrycia klas *Service spada tylko dlatego, że konstruktor
# przestał być pisany ręcznie.
lombok.addLombokGeneratedAnnotation = true
